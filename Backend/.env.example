JWT_SECRET_KEY=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-bytes

# SMTP para enviar los enlaces de verificación de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_BASE_URL=http://localhost:5000

# Cuenta del superusuario. Si ambas variables tienen valor, al arrancar se crea
# la cuenta o se le asigna el rol SUPERUSER. Use un correo que no sea de un administrador.
SUPERUSER_CORREO=superuser@example.com
SUPERUSER_PASSWORD=SOLOCALI123
